#!/bin/bash
# Minimal whiptail wrapper — selects defaults for community-scripts.
# Deployed to /tmp/silent-pve/whiptail and prepended to PATH so the
# community script calls this instead of the real whiptail.

# --menu: return "Default Install" for the initial menu, or match
#         var_container_storage / var_template_storage for storage menus.
if [[ "$*" == *"--menu"* ]]; then
  for needle in "$var_container_storage" "$var_template_storage" "$var_brg"; do
    [[ -n "$needle" ]] && for arg in "$@"; do
      [[ "$arg" == "$needle" ]] && { echo "$needle" >&2; exit 0; }
    done
  done
  if [[ "$*" == *"dhcp"* ]]; then echo "dhcp" >&2; exit 0; fi
  if [[ "$*" == *"none"* ]]; then echo "none" >&2; exit 0; fi
  # Fallback: extract the first tag from the menu list.
  args=("$@")
  count=0
  for (( i=0; i<${#args[@]}; i++ )); do
    if [[ "${args[$i]}" =~ ^[0-9]+$ ]]; then
      (( ++count == 3 )) && { echo "${args[$((i+1))]}" >&2; exit 0; }
    fi
  done
  exit 0
fi

# --radiolist: return ON item, or match storage env vars.
if [[ "$*" == *"--radiolist"* ]]; then
  args=("$@")
  for (( i=2; i<${#args[@]}; i++ )); do
    [[ "${args[$i]^^}" == "ON" ]] && { echo "${args[$((i-2))]}" >&2; exit 0; }
  done
  for needle in "$var_container_storage" "$var_template_storage"; do
    [[ -n "$needle" ]] && for (( i=0; i<${#args[@]}; i++ )); do
      [[ "${args[$i]}" == *"$needle"* ]] && { echo "${args[$i]}" >&2; exit 0; }
    done
  done
  exit 0
fi

# --inputbox: return the default value (last arg).
if [[ "$*" == *"--inputbox"* ]]; then echo "${@: -1}" >&2; exit 0; fi

# --passwordbox: empty password triggers autologin.
if [[ "$*" == *"--passwordbox"* ]]; then echo "" >&2; exit 0; fi

# Everything else (--yesno, --msgbox): simulate OK.
exit 0
